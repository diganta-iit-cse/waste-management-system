# ===================================================
# CineBook - Environment Configuration Variables
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Leave blank to automatically use the embedded development in-memory database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cinebook?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=cinebook_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRE=7d

# Default Admin Seed Account Credentials
ADMIN_NAME=Admin CineBook
ADMIN_EMAIL=admin@cinebook.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+919876543210

# Razorpay Payment Gateway (Optional - Mock mode active if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary Storage (Optional - Local placeholders used if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer Email Configuration (Optional - Mock mode active if empty)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="CineBook Tickets" <tickets@cinebook.com>
